            tensor<fp16, [32, 1, 1, 1]> var_34_cast_fp16 = conv(bias = fc_2_bias_to_fp16, dilations = var_34_dilations_0, groups = var_34_groups_0, pad = var_34_pad_0, pad_type = var_34_pad_type_0, strides = var_34_strides_0, weight = fc_2_weight_to_fp16, x = input_cast_fp16)[name = tensor<string, []>("op_34_cast_fp16")];
